# ====================================
# MyWeb 后端生产环境变量配置
# ====================================
# 此文件用于生产环境，不应提交到Git仓库
# 在docker-compose或部署脚本中会覆盖这些值

# 数据库配置
DATABASE_URL=sqlite:///app/data/my_web.db
AI_DATABASE_URL=sqlite:///app/data/znt.db
XBK_DATABASE_URL=sqlite:///app/data/xbk.db

# 静态文件目录
CONTENT_DIR=/app/content

# 安全密钥（生产环境必须更改）
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
XBK_JWT_SECRET_KEY=your_xbk_jwt_secret_key_change_in_production

# AI服务配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DIFY_API_KEY=your_dify_api_key_here
DIFY_BASE_URL=https://api.dify.ai/v1

# GitHub仓库同步
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=shuhao0727
GITHUB_REPO_NAME=2-My-notes
GITHUB_REPO_BRANCH=main
SYNC_INTERVAL_SECONDS=86400
ENABLE_AUTO_SYNC=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=backend.log

# 管理员默认配置
ADMIN_USERNAME=admin
ADMIN_STUDENT_ID=wangshu0727
# 注意：密码应在首次运行时设置，或通过初始化脚本设置
ADMIN_PASSWORD_HASH=暂不设置，使用初始化脚本生成

# 应用配置
HOST=0.0.0.0
PORT=8000
WORKERS=2
RELOAD=false