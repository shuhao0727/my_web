# ========================
# MyWeb 环境变量配置示例
# ========================
# 复制此文件为 .env 并根据实际环境进行配置

# ========================
# 应用基本配置
# ========================
APP_ENV=development
APP_DEBUG=true
APP_NAME=MyWeb
LOG_FILE=backend.log
LOG_LEVEL=INFO

# ========================
# 后端服务配置
# ========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ========================
# 数据库配置
# ========================
# XBK数据库配置
DATABASE_URL=sqlite:///./xbk.db
XBK_DATABASE_URL=sqlite:///./xbk.db
XBK_DB_PATH=./xbk.db

# AI数据库配置
AI_DATABASE_URL=sqlite:///./znt.db
ZNT_DB_PATH=./znt.db

# 数据库连接池配置
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10
DB_ECHO=false

# ========================
# 前端服务配置
# ========================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL_INTERNAL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=

# ========================
# 内容目录配置
# ========================
CONTENT_DIR=./content
GITHUB_REPO_NAME=2-My-notes

# ========================
# 安全认证配置
# ========================
# XBK JWT密钥（用于XBK模块认证）
XBK_JWT_SECRET_KEY=xbk-secret-key-change-in-production

# AI JWT密钥（用于AI模块认证）
JWT_SECRET_KEY=your-secret-key-change-in-production

# 管理员账户配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 特定用户配置
WANGSHU_USERNAME=wangshu0727
WANGSHU_PASSWORD=wangshu123

# ========================
# GitHub同步配置
# ========================
GITHUB_ACCESS_TOKEN=
GITHUB_OWNER=

# ========================
# AI服务配置
# ========================
DIFY_API_KEY=
DIFY_APP_ID=
DEEPSEEK_API_KEY=

# ========================
# 调度器配置
# ========================
ENABLE_AUTO_SYNC=false
SYNC_INTERVAL_SECONDS=3600

# ========================
# CORS跨域配置（生产环境需要配置）
# ========================
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6608,http://your-domain.com,https://your-domain.com

# ========================
# Docker构建配置（仅用于Docker构建）
# ========================
# DOCKER_REGISTRY=my_web
# IMAGE_TAG=latest
# DOMAIN_NAME=your-domain.com
