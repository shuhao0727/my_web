# ========================================
# MyWeb 环境变量配置模板 - 生产环境优化版
# 适用于AMD64 Linux系统部署 - 版本 1.0.0
# ========================================

# [必填] Docker镜像配置
DOCKER_HUB_USERNAME=shuhao07
# 镜像版本标签（建议使用具体版本如1.0.0，而不是latest）
BACKEND_IMAGE_TAG=1.0.0
FRONTEND_IMAGE_TAG=1.0.0

# [必填] 安全配置
SECRET_KEY=your-secret-key-change-in-production-至少32位随机字符串

# [可选] GitHub 同步配置（如果需要笔记同步功能）
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_OWNER=shuhao0727
GITHUB_REPO_NAME=2-My-notes
GITHUB_REPO_BRANCH=main
SYNC_INTERVAL_SECONDS=86400
ENABLE_AUTO_SYNC=true

# [可选] AI 服务配置（如果需要AI功能）
DIFY_API_KEY=
DIFY_APP_ID=
DEEPSEEK_API_KEY=

# [必填] 应用基础配置
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# [重要] 数据库配置
# SQLite 数据库配置（默认使用）
DATABASE_URL=sqlite:////app/xbk.db?check_same_thread=False
AI_DATABASE_URL=sqlite:////app/znt.db?check_same_thread=False
XBK_DATABASE_URL=sqlite:////app/xbk.db?check_same_thread=False

# PostgreSQL 数据库配置（如果需要）
# POSTGRES_PASSWORD=your_secure_password_here
# DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/myweb
# AI_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/ai_db
# XBK_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/xbk

# [可选] Redis 配置（如果需要缓存）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=300

# [重要] 管理员账户配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WANGSHU_USERNAME=wangshu0727
WANGSHU_PASSWORD=wangshu123

# [重要] CORS 配置
CORS_ORIGINS=http://localhost:6608,http://localhost:8000,http://localhost,http://nginx

# [重要] JWT 配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# [可选] 并发配置
WORKERS_PER_CORE=2
WEB_CONCURRENCY=4
MAX_WORKERS=8

# 端口配置（docker-compose中已定义，此处为参考）
BACKEND_PORT=8000
FRONTEND_PORT=6608

# ========================================
# 部署说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 必须修改的配置：
#    - DOCKER_HUB_USERNAME: 您的Docker Hub用户名（默认为shuhao07）
#    - SECRET_KEY: 生成安全的随机字符串（建议使用 openssl rand -hex 32 生成）
# 3. 可选配置：根据需求填写GitHub和AI服务配置
# 4. 注意：注释掉的行（以#开头）不会被使用，取消注释即可启用
# ========================================

# 提示：
# 1. 使用SQLite数据库时，无需修改数据库配置
# 2. 如果需要使用PostgreSQL，请注释掉SQLite配置，取消注释PostgreSQL配置
# 3. 所有配置项都有合理的默认值，只有标记为[必填]的项必须修改
# 4. 镜像版本：默认使用1.0.0版本，后续更新时修改BACKEND_IMAGE_TAG和FRONTEND_IMAGE_TAG
