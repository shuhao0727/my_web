# ====================================
# MyWeb 项目环境变量配置
# ====================================

# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ====================================
# GitHub私有仓库同步配置
# ====================================

# GitHub Personal Access Token (必需)
# 生成步骤：https://github.com/settings/tokens
# 需要勾选 'repo' 权限
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# GitHub仓库信息（已预设为您的仓库）
GITHUB_REPO_OWNER=shuhao0727
GITHUB_REPO_NAME=2-My-notes
GITHUB_REPO_BRANCH=main
# 可选：如果Typst文档在特定子目录中，请设置此路径
# 例如：docs/ 或 typst/
GITHUB_REPO_PATH=

# ====================================
# 数据库配置
# ====================================

# SQLite数据库路径
DATABASE_URL=sqlite:///./my_web.db

# ====================================
# 安全配置
# ====================================

# 用于JWT令牌签名的密钥（至少32个字符）
SECRET_KEY=your_secret_key_here_change_this_to_a_long_random_string

# ====================================
# 应用配置
# ====================================

# 后端服务端口
BACKEND_PORT=8000

# 前端服务端口
FRONTEND_PORT=6608

# 调试模式（开发环境设置为True）
DEBUG=True

# ====================================
# 日志配置
# ====================================

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ====================================
# 可选配置
# ====================================

# 定时同步间隔（秒，0表示禁用定时同步）
SYNC_INTERVAL_SECONDS=3600

# 是否启用自动同步（True/False）
ENABLE_AUTO_SYNC=False
