# ========================
# MyWeb 环境变量配置示例
# ========================
# 复制此文件为 .env 并根据实际环境进行配置

# ========================
# 应用基本配置
# ========================
APP_ENV=production
APP_DEBUG=false
APP_NAME=MyWeb
LOG_FILE=backend.log
LOG_LEVEL=INFO

# ========================
# 后端服务配置
# ========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ========================
# 数据库配置
# ========================
DATABASE_URL=sqlite:///xbk.db
AI_DATABASE_URL=sqlite:///znt.db
XBK_DB_PATH=/xbk.db
ZNT_DB_PATH=/znt.db
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10
DB_ECHO=false

# ========================
# 前端服务配置
# ========================
NEXT_PUBLIC_API_URL=http://localhost:6608/api
NEXT_PUBLIC_API_URL_INTERNAL=http://backend:8000
NEXT_PUBLIC_BASE_PATH=

# ========================
# 内容目录配置
# ========================
CONTENT_DIR=/content
GITHUB_REPO_NAME=2-My-notes

# ========================
# 安全认证配置
# ========================
XBK_JWT_SECRET_KEY=myweb-xbk-secret-key
JWT_SECRET_KEY=myweb-jwt-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WANGSHU_USERNAME=wangshu0727
WANGSHU_PASSWORD=wangshu123

# ========================
# GitHub同步配置
# ========================
GITHUB_ACCESS_TOKEN=
GITHUB_OWNER=

# ========================
# AI服务配置
# ========================
DIFY_API_KEY=
DIFY_APP_ID=
DEEPSEEK_API_KEY=

# ========================
# 调度器配置
# ========================
ENABLE_AUTO_SYNC=false
SYNC_INTERVAL_SECONDS=3600

# ========================
# API配置
# ========================
API_RATE_LIMIT=100
API_TIMEOUT=30

# ========================
# CORS跨域配置
# ========================
ALLOWED_ORIGINS=http://localhost:6608,http://nginx:6608

# ========================
# Typst配置
# ========================
TYPST_ROOT_PATH=/content

# ========================
# 调度器配置
# ========================
SCHEDULER_MAX_WORKERS=2
SCHEDULER_COALESCE=true
SCHEDULER_MISFIRE_GRACE_TIME=30
