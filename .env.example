# 通用配置
APP_ENV=development
APP_DEBUG=true
APP_NAME=MyWeb

# 后端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./xbk.db
AI_DATABASE_URL=sqlite:///./znt.db

# 前端配置
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL_INTERNAL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=
FRONTEND_HOST=localhost
FRONTEND_PORT=3000

# GitHub配置
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_NAME=2-My-notes
GITHUB_OWNER=

# 内容目录配置
CONTENT_DIR=./content

# 数据库配置
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10
DB_ECHO=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=app.log

# API配置
API_RATE_LIMIT=100
API_TIMEOUT=30

# 同步配置
SYNC_INTERVAL_SECONDS=3600
ENABLE_AUTO_SYNC=false

# Typst配置
TYPST_ROOT_PATH=./content

# 调度器配置
SCHEDULER_MAX_WORKERS=2
SCHEDULER_COALESCE=true
SCHEDULER_MISFIRE_GRACE_TIME=30