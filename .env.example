# ========================================
# MyWeb 环境变量配置模板
# ========================================

# 数据库配置
POSTGRES_PASSWORD=your_secure_password_here

# 安全配置
SECRET_KEY=your-secret-key-change-in-production

# GitHub 同步配置（可选）
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_OWNER=shuhao0727
GITHUB_REPO_NAME=2-My-notes
GITHUB_REPO_BRANCH=main
SYNC_INTERVAL_SECONDS=86400
ENABLE_AUTO_SYNC=true

# AI 服务配置（可选）
DIFY_API_KEY=your_dify_api_key_here
DIFY_APP_ID=your_dify_app_id_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 管理员账户配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WANGSHU_USERNAME=wangshu0727
WANGSHU_PASSWORD=wangshu123

# 应用配置
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=300

# PostgreSQL 数据库配置
DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/myweb
AI_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/ai_db
XBK_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/xbk

# SQLite 数据库路径（开发/测试环境）
XBK_DB_PATH=/app/data/xbk.db
ZNT_DB_PATH=/app/data/znt.db

# 内容目录
CONTENT_DIR=/app/content

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:6608,http://frontend:6608

# JWT 配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 并发配置
WORKERS_PER_CORE=2
WEB_CONCURRENCY=4
MAX_WORKERS=8

# ========================================
# 部署说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改必要的配置项（特别是密码和密钥）
# 3. 不需要的配置项可以留空或删除
# ========================================