# ========================================
# MyWeb - 统一环境变量配置文件模板
# 支持开发和生产环境一键切换
# 用法：cp .env.template .env 然后编辑需要的配置
# ========================================

# [环境切换配置] =================================
# 开发环境：ENVIRONMENT=development, DEBUG=true
# 生产环境：ENVIRONMENT=production, DEBUG=false
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# [构建模式配置] =================================
# 构建模式：local=本地构建, remote=远程镜像
BUILD_MODE=local

# Docker Hub配置（当BUILD_MODE=remote时使用）
DOCKER_HUB_USERNAME=shuhao07
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# [服务配置] =====================================
# 容器名称（可选）
BACKEND_CONTAINER_NAME=myweb-backend
FRONTEND_CONTAINER_NAME=myweb-frontend
NGINX_CONTAINER_NAME=myweb-nginx

# 端口配置
BACKEND_PORT=8000
FRONTEND_PORT=6608
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=8443

# [数据库配置] ===================================
# SQLite数据库配置（统一使用 /backend 绝对路径）
DATABASE_URL=sqlite:////backend/xbk.db?check_same_thread=False
AI_DATABASE_URL=sqlite:////backend/znt.db?check_same_thread=False
XBK_DATABASE_URL=sqlite:////backend/xbk.db?check_same_thread=False
USE_POSTGRESQL=false

# PostgreSQL配置（如果需要，设置USE_POSTGRESQL=true）
# POSTGRES_PASSWORD=your_secure_password_here
# DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/myweb
# AI_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/ai_db
# XBK_DATABASE_URL=postgresql://myweb_user:${POSTGRES_PASSWORD}@postgres:5432/xbk

# [数据持久化配置] ===============================
# 数据持久化模式：local=本地挂载, docker=Docker卷
DATA_PERSISTENCE_MODE=local

# [安全配置] ====================================
SECRET_KEY=your-secret-key-change-in-production-至少32位随机字符串
CORS_ORIGINS=http://localhost:6608,http://localhost:8000,http://localhost

# JWT配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# [管理员账户] ==================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WANGSHU_USERNAME=wangshu0727
WANGSHU_PASSWORD=wangshu123

# [GitHub同步配置] ==============================
# 可选配置，如果需要笔记同步功能
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_OWNER=shuhao0727
GITHUB_REPO_NAME=2-My-notes
GITHUB_REPO_BRANCH=main
SYNC_INTERVAL_SECONDS=86400
ENABLE_AUTO_SYNC=true

# [AI服务配置] ==================================
# 可选配置，如果需要AI功能
DIFY_API_KEY=
DIFY_APP_ID=
DEEPSEEK_API_KEY=

# [网络配置] ====================================
# Docker网络配置
NETWORK_SUBNET=172.20.0.0/16

# [Nginx配置] ==================================
# 仅在生产环境启用
ENABLE_NGINX=false

# [性能配置] ===================================
WORKERS_PER_CORE=2
WEB_CONCURRENCY=4
MAX_WORKERS=8

# [前端配置] ====================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
PORT=6608
HOST=localhost
FRONTEND_PORT=6608
FRONTEND_HOST=localhost

# [内容目录配置] ================================
CONTENT_DIR=./backend/content

# ==============================================
# 快速切换预设配置
# ==============================================

# [开发环境预设] - 复制到.env文件最前面
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=DEBUG
# BUILD_MODE=local
# DATA_PERSISTENCE_MODE=local
# ENABLE_NGINX=false

# [生产环境预设] - 复制到.env文件最前面
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# BUILD_MODE=remote
# DATA_PERSISTENCE_MODE=docker
# ENABLE_NGINX=true
# CORS_ORIGINS=http://nginx,http://localhost,http://localhost:80,http://localhost:8443

# [生产环境简化版] - 无Nginx
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# BUILD_MODE=remote
# DATA_PERSISTENCE_MODE=docker
# ENABLE_NGINX=false

# ==============================================
# 使用说明：
# 1. 复制模板：cp .env.template .env
# 2. 选择环境：根据需求取消注释上面的环境预设
# 3. 修改必填项：SECRET_KEY必须修改
# 4. 可选配置：根据需要填写GitHub和AI服务配置
# 5. 启动服务：
#    开发环境：docker-compose up -d
#    生产环境：docker-compose --env-file .env.prod up -d
# ==============================================